{
  "name": "tixo-backend",
  "version": "1.0.0",
  "description": "TIXO Real-Time gRPC Cinema Ticketing Backend Server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:concurrency": "ts-node src/test/simulateRaceCondition.ts"
  },
  "keywords": [
    "grpc",
    "cinema-ticketing",
    "real-time",
    "streaming",
    "concurrency",
    "mysql"
  ],
  "author": "Muhammad Azharuddiya Syam Ramadhan",
  "license": "ISC",
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "dotenv": "^16.4.7",
    "mysql2": "^3.12.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/uuid": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}